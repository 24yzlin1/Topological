from pathlib import Path
from app.core.type import Graph
# load_graph_from_string

def load_graph_from_file(path: str) -> Graph:
    """
    从文件读取关系，返回 Graph
    文件格式：每行一个 <a,b>
    """
    file = Path(path)
    if not file.exists():
        raise FileNotFoundError(f"文件不存在：{path}")

    raw = file.read_text(encoding="utf-8")
    if not raw.strip():
        raise ValueError("文件是空的")

    return load_graph_from_string(raw)

def save_sorts_to_txt(path: str, sorts: list[list["Node"]]) -> None:
    """
    把拓扑排序结果写到 txt
    """
    with open(path, "w", encoding="utf-8") as f:
        for i, order in enumerate(sorts, 1):
            names = [node.name for node in order]
            f.write(f"方案{i}: " + " -> ".join(names) + "\n")

def save_graph_to_file(path: str, graph: Graph) -> None:
    """
    把当前图的关系导出成 <a,b> 格式
    """
    with open(path, "w", encoding="utf-8") as f:
        for edge_id in graph.edges:
            edge = graph.get_edge(edge_id)
            f.write(f"<{edge.source.name},{edge.target.name}>\n")

import csv

def save_sorts_to_csv(path: str, sorts: list[list["Node"]]) -> None:
    with open(path, "w", encoding="utf-8", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["方案编号", "拓扑排序"])
        for i, order in enumerate(sorts, 1):
            names = [node.name for node in order]
            writer.writerow([i, " -> ".join(names)])
